#!/bin/sh
# The recovery listener is independent of the native panel and persistent state.
set -u
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr:/usr/lte:/usr/gps
bundle=/usr/lib/titan-api
[ "${1:-}" = boot ] || exit 64
if [ "${WITCHER_BOOT_COPY:-}" != 1 ]; then
 cp "$0" /tmp/witcher-boot.sh || exit 1
 WITCHER_BOOT_COPY=1 exec /bin/sh /tmp/witcher-boot.sh boot
fi
# Apply once per boot. Keep the kernel softirq deadline and scheduling policy.
for setting in netdev_budget=300 dev_weight=128 netdev_max_backlog=4000; do
 echo "${setting#*=}" > "/proc/sys/net/core/${setting%=*}" || echo "Unable to apply $setting" >&2
done
# /tmp is ramfs on this unit: no size limit, and every byte stays in RAM.
# Once a minute, a Witcher log over 64 KB keeps its last 16 KB in NAME.1 and
# starts again empty. Every writer appends (O_APPEND), so emptying the file in
# place is safe while it is open.
log_cap=65536
log_keep=16384
cap_logs() {
 for file in /tmp/witcher-management.log /tmp/witcher-recovery.log \
  /tmp/titan-sshd-boot.log /tmp/titan-pd-keeper-boot.log /tmp/titan-api-boot.log \
  /tmp/witcher-api/api.log /tmp/witcher-api/broker.log /tmp/witcher-api/collector.log \
  /tmp/witcher-api/routes.log; do
  [ -f "$file" ] && [ ! -L "$file" ] || continue
  size=$(wc -c < "$file" 2> /dev/null) || continue
  # Some wc builds pad the count. Never let a bad value end this loop.
  size=${size##* }
  case "$size" in ''|*[!0-9]*) continue;; esac
  [ "$size" -gt "$log_cap" ] || continue
  rm -f "$file.1"
  (umask 077; set -C; tail -c "$log_keep" "$file" > "$file.1") 2> /dev/null
  : > "$file"
 done
}
# Whole seconds since boot in $now; the wall clock is not set early in boot.
clock() { read -r now _ < /proc/uptime; now=${now%%.*}; }
# A process that has exited, reaped or still a zombie. Where sleep is a shell
# builtin nothing may have reaped our own child yet, and kill -0 still succeeds.
exited() {
 stat=; { read -r stat < "/proc/$1/stat"; } 2> /dev/null
 case "${stat##*) }" in ''|[ZX]*) return 0;; esac
 return 1
}
running() {
 owner=$(cat "$1" 2> /dev/null)
 case "$owner" in ''|*[!0-9]*) return 1;; esac
 ! exited "$owner"
}
# An inherited pipe must never keep rcS waiting for these long-lived services.
start_management() {
 management_loop </dev/null >/dev/null 2>&1 &
 echo $! > /tmp/witcher-management-loop.pid
}
start_recovery() {
 recovery_loop </dev/null >/dev/null 2>&1 &
 echo $! > /tmp/witcher-recovery-loop.pid
}
# Vendor startup and re-attachments can rebuild their tables. Keep management
# available independently of panel startup, APN provisioning and saved flags.
# Once a minute this loop is also the watchdog: it starts a shell or keeper
# supervisor that died (not one an operator stopped) and the recovery loop.
management_loop() {
 tick=0
 while :; do
  /bin/sh /etc/init.d/witcher-management-access all >> /tmp/witcher-management.log 2>&1
  tick=$((tick + 1))
  if [ "$tick" -ge 6 ]; then
   tick=0
   cap_logs
   # In the background: a start that waits for the volume must not hold up
   # the access rules. Each start takes its own lock.
   /bin/sh /etc/init.d/titan-sshd ensure >> /tmp/titan-sshd-boot.log 2>&1 &
   /bin/sh /etc/init.d/titan-pd-keeper ensure >> /tmp/titan-pd-keeper-boot.log 2>&1 &
   running /tmp/witcher-recovery-loop.pid || start_recovery
  fi
  sleep 10
 done
}
# The recovery listener starts again after 5 s, doubling to 5 min while it
# keeps exiting within a minute. This loop restarts the management loop.
recovery_loop() {
 delay=5
 while :; do
  clock; started=$now
  "$bundle/witcher-firstboot" recovery >> /tmp/witcher-recovery.log 2>&1 &
  listener=$!
  while sleep 10; ! exited "$listener"; do
   running /tmp/witcher-management-loop.pid || start_management
  done
  wait "$listener"
  clock
  [ $((now - started)) -lt 60 ] || delay=5
  sleep "$delay"
  delay=$((delay * 2)); [ "$delay" -le 300 ] || delay=300
 done
}
start_management
# This supervisor waits for kernel entropy if needed. It does not wait for TLS
# generation or native web health; existing enrolled keys remain usable.
/bin/sh /etc/init.d/titan-sshd boot </dev/null >> /tmp/titan-sshd-boot.log 2>&1 &
# IPv4 repair and IPv6 delegation must survive a failed web/TLS startup.
/bin/sh /etc/init.d/titan-pd-keeper start </dev/null >> /tmp/titan-pd-keeper-boot.log 2>&1 &
start_recovery
/bin/sh /etc/init.d/titan-api boot </dev/null >> /tmp/titan-api-boot.log 2>&1
